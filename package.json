{
  "name": "life-quest",
  "version": "0.2.8",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lifequest/desktop",
    "dev:desktop": "npm run dev -w @lifequest/desktop",
    "test": "npm run test -w @lifequest/desktop",
    "build": "npm run build -w @lifequest/desktop",
    "package": "npm run package -w @lifequest/desktop",
    "release": "npm run release -w @lifequest/desktop",
    "typecheck": "npm run typecheck -w @lifequest/desktop",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:build": "node scripts/build-docs.mjs && mkdocs build --strict",
    "docs:serve": "node scripts/build-docs.mjs && mkdocs serve"
  }
}
