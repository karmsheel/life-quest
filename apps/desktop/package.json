    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.511.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.6.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "zod": "^4.0.0"
