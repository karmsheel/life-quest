{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "types": ["node"],
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["electron/**/*"]
}
