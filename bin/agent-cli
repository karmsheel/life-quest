#!/usr/bin/env node
"use strict";

/**
 * agent-cli — one place for the LifeQuest repo facts, lookups and canonical
 * commands an agent keeps re-deriving from transcripts.
 *
 * Zero dependencies: Node 22 builtins only (fs, path, child_process, node:sqlite).
 *
 * Safety model: read-only by default. The only actions that touch anything are
 * explicit ones — `bench move|stop|shot` (the one bench / display), `e2e run`
 * (locked E2E through lifequest-e2e), `check typecheck` (npm run typecheck) and
 * `db query` (opens sqlite read-only). Every spawning action supports --dry-run,
 * and nothing else writes: `check typecheck` keeps its last-run summary under
 * the gitignored .scratch/agent-cli/ so `check summary` can read it.
 *
 * Output contract
 *   text    terse, one fact per line, written for agents
 *   --json  {"cmd":"<name>","ok":true,"data":{...}} on stdout (stable keys)
 *   error   {"cmd":"<name>","ok":false,"error":"..."} + exit 1 (runtime)
 *           stderr "agent-cli: ..." + exit 2 (usage)
 *
 * Repo root: dirname(dirname(realpath(argv[1]))); AGENT_CLI_ROOT overrides.
 * Works from any cwd; when run in a worktree it reports that worktree.
 */

const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const CLI_VERSION = "0.1.0";
const BENCH_DEV = "/root/.local/bin/lifequest-dev";
const BENCH_SHOT = "/root/.local/bin/lifequest-shot";
const BENCH_E2E = "/root/.local/bin/lifequest-e2e";
const BENCH_STATE = "/root/.local/state/lifequest-dev/bench.env";
const E2E_LOCK = "/run/lifequest-e2e.lock";
const TMUX_SESSION = "lq-dev";
const VNC_URL = "http://100.88.181.80:6080/vnc.html?autoconnect=1&resize=scale";

function resolveRepoRoot() {
  const fromEnv = process.env.AGENT_CLI_ROOT;
  if (fromEnv && fromEnv.trim()) return path.resolve(fromEnv.trim());
  const self = process.argv[1] || process.cwd();
  try {
    return path.dirname(path.dirname(fs.realpathSync(self)));
  } catch {
    return process.cwd();
  }
}
const ROOT = resolveRepoRoot();

// ---------------------------------------------------------------------------
// Output + process plumbing
// ---------------------------------------------------------------------------

function stdout(text) {
  process.stdout.write(text.endsWith("\n") ? text : `${text}\n`);
}

function emit(ctx, lines, data) {
  if (ctx.json) {
    stdout(JSON.stringify({ cmd: ctx.commandName, ok: true, data }, null, 2));
    return;
  }
  const text = (lines || []).filter((line) => line && String(line).length);
  if (text.length) stdout(text.join("\n"));
}

function failRun(ctx, message, data) {
  if (ctx && ctx.json) {
    stdout(JSON.stringify({ cmd: ctx ? ctx.commandName : null, ok: false, error: message, data: data || null }, null, 2));
  }
  process.stderr.write(`agent-cli: ${message}\n`);
  process.exit(1);
}

function usageFail(message) {
  process.stderr.write(`agent-cli: ${message}\nrun 'agent-cli help' for usage\n`);
  process.exit(2);
}

// ---------------------------------------------------------------------------
// Generic helpers
// ---------------------------------------------------------------------------

function run(cmd, args, options) {
  const opts = options || {};
  const result = spawnSync(cmd, args, {
    cwd: opts.cwd || ROOT,
    encoding: "utf8",
    timeout: opts.timeout || 10000,
    maxBuffer: 16 * 1024 * 1024,
    env: process.env,
  });
  return {
    ok: !result.error && result.status === 0,
    code: typeof result.status === "number" ? result.status : 1,
    missing: Boolean(result.error && result.error.code === "ENOENT"),
    stdout: result.stdout || "",
    stderr: result.stderr || "",
  };
}

function execTool(file, args, options) {
  if (!fs.existsSync(file)) throw new Error(`${file} not found on this host`);
  return run(file, args, options);
}

function abs(rel) {
  return path.isAbsolute(rel) ? rel : path.join(ROOT, rel);
}

function exists(rel) {
  try {
    return fs.existsSync(abs(rel));
  } catch {
    return false;
  }
}

function readText(rel) {
  try {
    return fs.readFileSync(abs(rel), "utf8");
  } catch {
    return null;
  }
}

function readJson(rel) {
  const text = readText(rel);
  if (text === null) return null;
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

function readDir(rel) {
  try {
    return fs.readdirSync(abs(rel)).sort();
  } catch {
    return null;
  }
}

function listFiles(rel, suffix) {
  const names = readDir(rel);
  if (names === null) return [];
  return names.filter((name) => name.endsWith(suffix)).map((name) => `${rel}/${name}`);
}

function capLimit(ctx, fallback, max) {
  return capFlag(ctx, "limit", fallback, max);
}

function capFlag(ctx, name, fallback, max) {
  const raw = ctx.flags[name];
  if (raw === undefined) return fallback;
  const n = Number(raw);
  if (!Number.isInteger(n) || n < 0) usageFail(`--${name} expects a non-negative integer`);
  return Math.min(n, max);
}

function tailText(text, bytes) {
  const buffer = Buffer.from(text, "utf8");
  if (buffer.length <= bytes) return { text, truncated: false };
  return { text: buffer.subarray(buffer.length - bytes).toString("utf8"), truncated: true };
}

// ---------------------------------------------------------------------------
// Git
// ---------------------------------------------------------------------------

function git(args, options) {
  return run("git", ["-C", ROOT, ...args], options);
}

function gitLine(args) {
  const result = git(args);
  return result.ok ? result.stdout.trim() : null;
}

function worktreeInfo() {
  const gitDir = gitLine(["rev-parse", "--absolute-git-dir"]);
  const commonRaw = gitLine(["rev-parse", "--git-common-dir"]);
  const commonDir = commonRaw ? path.resolve(ROOT, commonRaw) : null;
  const isWorktree = Boolean(gitDir && commonDir && gitDir !== commonDir);
  return {
    isWorktree,
    gitDir: gitDir || null,
    commonDir: commonDir || null,
    primaryRoot: isWorktree && commonDir ? path.dirname(commonDir) : ROOT,
  };
}

function headInfo() {
  const sha = gitLine(["rev-parse", "HEAD"]);
  if (!sha) return null;
  return {
    sha,
    short: sha.slice(0, 7),
    subject: gitLine(["log", "-1", "--format=%s"]),
    date: gitLine(["log", "-1", "--format=%cs"]),
  };
}

function statusInfo() {
  const result = git(["status", "--porcelain=v1", "-b"]);
  if (!result.ok) return null;
  const files = [];
  let branchLine = null;
  for (const line of result.stdout.split("\n")) {
    if (!line) continue;
    if (line.startsWith("## ")) {
      branchLine = line.slice(3);
      continue;
    }
    files.push({ code: line.slice(0, 2), path: line.slice(3) });
  }
  let upstream = null;
  let ahead = null;
  let behind = null;
  if (branchLine) {
    const upstreamPart = branchLine.split("...")[1];
    if (upstreamPart) upstream = upstreamPart.split(" ")[0];
    const bracket = branchLine.match(/\[([^\]]*)\]/);
    if (bracket) {
      const a = bracket[1].match(/ahead (\d+)/);
      const b = bracket[1].match(/behind (\d+)/);
      if (a) ahead = Number(a[1]);
      if (b) behind = Number(b[1]);
    }
  }
  const counts = { staged: 0, unstaged: 0, untracked: 0, deleted: 0, renamed: 0 };
  for (const file of files) {
    const x = file.code[0];
    const y = file.code[1];
    if (x === "?" && y === "?") {
      counts.untracked += 1;
      continue;
    }
    if (x !== " " && x !== "?") counts.staged += 1;
    if (y !== " " && y !== "?") counts.unstaged += 1;
    if (x === "D" || y === "D") counts.deleted += 1;
    if (x === "R" || y === "R") counts.renamed += 1;
  }
  return { branchLine, upstream, ahead, behind, clean: files.length === 0, counts, files };
}

function repoState() {
  return {
    root: ROOT,
    branch: gitLine(["rev-parse", "--abbrev-ref", "HEAD"]),
    head: headInfo(),
    worktree: worktreeInfo(),
    status: statusInfo(),
  };
}

function commitList(limit) {
  const result = git(["log", `-n${limit}`, "--format=%h\u001f%s\u001f%cs"]);
  if (!result.ok) return [];
  return result.stdout
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [short, subject, date] = line.split("\u001f");
      return { short, subject, date };
    });
}

function worktreeList() {
  const result = git(["worktree", "list", "--porcelain"]);
  if (!result.ok) return [];
  const out = [];
  for (const block of result.stdout.split("\n\n")) {
    const entry = { path: null, sha: null, branch: null, bare: false, detached: false, isCurrent: false };
    for (const line of block.split("\n")) {
      if (line.startsWith("worktree ")) entry.path = line.slice(9);
      else if (line.startsWith("HEAD ")) entry.sha = line.slice(5);
      else if (line.startsWith("branch ")) entry.branch = line.slice(7).replace(/^refs\/heads\//, "");
      else if (line === "bare") entry.bare = true;
      else if (line === "detached") entry.detached = true;
    }
    if (entry.path) {
      entry.isCurrent = entry.path === ROOT;
      out.push(entry);
    }
  }
  return out;
}

function checkoutFromCwd() {
  const result = run("git", ["rev-parse", "--show-toplevel"], { cwd: process.cwd(), timeout: 4000 });
  return result.ok && result.stdout.trim() ? result.stdout.trim() : ROOT;
}

// ---------------------------------------------------------------------------
// Live machine facts
// ---------------------------------------------------------------------------

function listeningPorts() {
  const result = run("ss", ["-H", "-ltn"], { timeout: 5000 });
  if (!result.ok) return null;
  const ports = new Set();
  for (const line of result.stdout.split("\n")) {
    const match = line.trim().match(/:(\d+)\s/);
    if (match) ports.add(Number(match[1]));
  }
  return ports;
}

function readBenchState() {
  const text = readText(BENCH_STATE);
  if (text === null) return null;
  const state = { repo: null, branch: null, display: null, port: null };
  for (const line of text.split("\n")) {
    const match = line.match(/^([A-Z]+)=(.*)$/);
    if (!match) continue;
    const value = match[2].replace(/^'(.*)'$/, "$1").replace(/^"(.*)"$/, "$1").replace(/\\'/g, "'");
    if (match[1] === "REPO") state.repo = value;
    else if (match[1] === "BRANCH") state.branch = value;
    else if (match[1] === "DISPLAY") state.display = value;
    else if (match[1] === "PORT") state.port = Number(value) || null;
  }
  return state;
}

function benchLive() {
  const ports = listeningPorts();
  const session = run("tmux", ["has-session", "-t", TMUX_SESSION], { timeout: 3000 });
  return {
    stateFile: BENCH_STATE,
    state: readBenchState(),
    display: ":99",
    displayUp: fs.existsSync("/tmp/.X11-unix/X99"),
    tmuxSession: session.missing ? null : session.ok,
    port5173: ports === null ? null : ports.has(5173),
    listeningKnown: ports !== null,
    vncUrl: VNC_URL,
  };
}

function e2eLockState() {
  const present = fs.existsSync(E2E_LOCK);
  let busy = null;
  if (present) {
    const probe = run("flock", ["-n", E2E_LOCK, "true"], { timeout: 3000 });
    if (!probe.missing) busy = !probe.ok;
  }
  return { path: E2E_LOCK, present, busy };
}

function nodeModulesInfo() {
  const present = exists("node_modules");
  let vaultCoreResolved = null;
  try {
    vaultCoreResolved = fs.realpathSync(abs("node_modules/@lifequest/vault-core"));
  } catch {
    vaultCoreResolved = null;
  }
  const local = vaultCoreResolved
    ? vaultCoreResolved === ROOT || vaultCoreResolved.startsWith(`${ROOT}${path.sep}`)
    : null;
  return { present, path: `${ROOT}/node_modules`, vaultCoreResolved, vaultCoreLocal: local };
}

function artifactFiles() {
  let names;
  try {
    names = fs.readdirSync(abs("apps/desktop/e2e/artifacts"));
  } catch {
    return [];
  }
  return names
    .filter((name) => name.endsWith(".json") || name.endsWith(".png"))
    .map((name) => {
      const full = abs(`apps/desktop/e2e/artifacts/${name}`);
      let stat = null;
      try {
        stat = fs.statSync(full);
      } catch {
        stat = null;
      }
      return {
        name,
        path: `apps/desktop/e2e/artifacts/${name}`,
        size: stat ? stat.size : null,
        mtime: stat ? stat.mtime.toISOString() : null,
      };
    })
    .sort((a, b) => (a.mtime < b.mtime ? 1 : a.mtime > b.mtime ? -1 : a.name.localeCompare(b.name)));
}

function reportStatus(report) {
  if (!report || typeof report !== "object") return "unknown";
  if (report.pass === true) return "pass";
  if (report.pass === false) return "fail";
  if (Array.isArray(report.failures)) return report.failures.length ? "fail" : "pass";
  if (report.ok === true) return "pass";
  if (report.ok === false) return "fail";
  return "unknown";
}

function lastReport() {
  for (const file of artifactFiles()) {
    if (!file.name.endsWith(".json")) continue;
    const report = readJson(file.path);
    const scenarios = report && report.checks && Array.isArray(report.checks.scenarios) ? report.checks.scenarios : null;
    return {
      artifact: file.path,
      mtime: file.mtime,
      status: reportStatus(report),
      pass: report && typeof report.pass === "boolean" ? report.pass : null,
      failures: report && Array.isArray(report.failures) ? report.failures : [],
      failureCount: report && Array.isArray(report.failures) ? report.failures.length : 0,
      scenarioCount: scenarios ? scenarios.length : null,
      scenarios: scenarios ? scenarios.map((s) => ({ name: s.name, pass: s.pass === true })) : null,
    };
  }
  return null;
}

async function dbQuery(databasePath, sql) {
  const { DatabaseSync } = require("node:sqlite");
  const db = new DatabaseSync(databasePath, { readOnly: true });
  try {
    const statement = db.prepare(sql);
    const rows = statement.all();
    return rows;
  } finally {
    db.close();
  }
}

